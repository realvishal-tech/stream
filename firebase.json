{
  "database": { "rules": "database.rules.json" },
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "database.rules.json", "README.md", "package.json", "package-lock.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": false,
    "headers": [
      { "source": "**/*.@(css|js|svg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] },
      { "source": "service-worker.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**", "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ] }
    ]
  }
}
